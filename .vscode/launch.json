{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "train",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "./src:${env:PYTHONPATH}",
        "CUDA_VISIBLE_DEVICES": "1",
        "WANDB_PROJECT": "debugs"
      },
      "justMyCode": false,
      "args": [
        "--num_processes=1",
        "--mixed_precision=bf16",
        "-m",
        "csi_slt.commands.train",
        "model=qwen3-1.7b-cradio-l-dinoframecrossv2shuffle",
        "data=ph14t_*x224x224_qwen_multiling",
        "datamodule=shared_subset",
        "engine.training_args.report_to=none",
        "engine.training_args.save_steps=1000",
        "engine.training_args.eval_steps=4",
        "engine.training_args.do_train=True",
        "engine.training_args.dataloader_num_workers=8",
        "engine.training_args.output_dir=outputs/debug_outputs",
        "engine.training_args.disable_tqdm=False",
        "data.processor.video_token_scale=1.0",
        "data.processor.video_processor.padding_to_multiple_of=4",
        "data.processor.video_processor.do_normalize=False"
      ]
    },
    {
      "name": "preprocess",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/preprocess/dataset_preprocess-T.py",
      "console": "integratedTerminal",
      "args": [
        "--process-image"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "train_ft_peft",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "./src:${env:PYTHONPATH}",
        "CUDA_VISIBLE_DEVICES": "0",
        "WANDB_PROJECT": "debugs"
      },
      "justMyCode": false,
      "args": [
        "--num_processes=1",
        "--mixed_precision=fp16",
        "-m",
        "csi_slt.commands.train_ft_peft",
        "model.checkpoint_dir=outputs/qwen3-1.7b-dinoframev2-shuffle-cross-0731//checkpoint-68000",
        "data.processor.video_token_scale=1.0",
        "engine.training_args.report_to=none",
        "engine.training_args.output_dir=./outputs/debug_outputs"
      ]
    },
    {
      "name": "train_ft",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "./src:${env:PYTHONPATH}",
        "CUDA_VISIBLE_DEVICES": "0",
        "WANDB_PROJECT": "debugs"
      },
      "justMyCode": false,
      "args": [
        "--num_processes=2",
        "--mixed_precision=fp16",
        "-m",
        "csi_slt.commands.train_ft",
        "engine.training_args.report_to=none",
        "engine.training_args.auto_output_root=./outputs/debug_outputs",
        "engine.training_args.dataloader_num_workers=0"
      ]
    },
    {
      "name": "eval",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "./src:${env:PYTHONPATH}",
        "CUDA_VISIBLE_DEVICES": "0",
        "WANDB_PROJECT": "debugs"
      },
      "justMyCode": false,
      "args": [
        "--num_processes=1",
        "--mixed_precision=fp16",
        "-m",
        "csi_slt.commands.evaluate",
        "model.checkpoint_dir=outputs/qwen3-8b-dino-b-dinoframe/checkpoint-164000",
        "engine.training_args.dataloader_num_workers=4"
      ]
    }
  ]
}
