{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "train",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "./src:${env:PYTHONPATH}",
        "CUDA_VISIBLE_DEVICES": "0",
        "WANDB_PROJECT": "debugs"
      },
      "justMyCode": false,
      "args": [
        "--num_processes=1",
        "--mixed_precision=fp16",
        "-m",
        "csi_slt.commands.train",
        "model=gemma3-4b-dino-base-tsamplerv2",
        "data=ph14t_*x224x224_gemma_multiling",
        "model.config.visual_adapter_kwargs.num_layers_connector=3",
        "engine.training_args.report_to=none",
        "engine.training_args.save_steps=1000",
        "engine.training_args.eval_steps=1000",
        "engine.training_args.do_train=True",
        "engine.training_args.dataloader_num_workers=4",
        "engine.training_args.output_dir=outputs/debug_outputs",
        "engine.training_args.disable_tqdm=False",
        "model.config.video_token_scale=0.125",
        "data.train.processor.video_token_scale=0.125",
        "data.val.processor.video_token_scale=0.125",
        "data.test.processor.video_token_scale=0.125",
        "data.train.processor.video_padding_to_multiple_of=8",
        "data.val.processor.video_padding_to_multiple_of=8",
        "data.test.processor.video_padding_to_multiple_of=8"
      ]
    },
    {
      "name": "preprocess",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/preprocess/dataset_preprocess-T.py",
      "console": "integratedTerminal",
      "args": [
        "--process-image"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "train_ft_peft",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "./src:${env:PYTHONPATH}",
        "CUDA_VISIBLE_DEVICES": "0",
        "WANDB_PROJECT": "debugs"
      },
      "justMyCode": false,
      "args": [
        "--num_processes=1",
        "--mixed_precision=fp16",
        "-m",
        "csi_slt.commands.train_ft_peft",
        "engine.training_args.report_to=none",
        "engine.training_args.auto_output_root=./outputs/debug_outputs",
        "engine.training_args.dataloader_num_workers=0"
      ]
    },
    {
      "name": "train_ft",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "./src:${env:PYTHONPATH}",
        "CUDA_VISIBLE_DEVICES": "0",
        "WANDB_PROJECT": "debugs"
      },
      "justMyCode": false,
      "args": [
        "--num_processes=1",
        "--mixed_precision=fp16",
        "-m",
        "csi_slt.commands.train_ft",
        "engine.training_args.report_to=none",
        "engine.training_args.auto_output_root=./outputs/debug_outputs",
        "engine.training_args.dataloader_num_workers=0"
      ]
    },
    {
      "name": "eval",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "./src:${env:PYTHONPATH}",
        "CUDA_VISIBLE_DEVICES": "0",
        "WANDB_PROJECT": "debugs"
      },
      "justMyCode": false,
      "args": [
        "--num_processes=1",
        "--mixed_precision=fp16",
        "-m",
        "csi_slt.commands.evaluate",
        "model.checkpoint_dir=outputs/qwen3-1.7b-dino-base-tsamplerv2-shuffle-2/checkpoint-164000",
        "engine.training_args.dataloader_num_workers=4"
      ]
    }
  ]
}
